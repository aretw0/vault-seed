  "license": {
    "type": "CC BY-SA 4.0",
    "holder": "aretw0",
    "holderUrl": "https://github.com/aretw0"
  },
  "kudos": "Feito com ♥",
  "status": {
    "states": ["draft", "published"],
    "publicState": "published"
  },
  "folders": {
    "excludeFromPublic": ["90 - Modelos"]
  },
  "records": {
    "context": {
      "base": "https://refarm.dev/contexts/records/v1",
      "vocab": null
    },
    "typeByFolder": {
      "00 - Entrada": "Inbox",
      "10 - Diário": "Journal",
      "20 - Projetos": "Project",
      "30 - Áreas": "Area",
      "40 - Recursos": "Resource",
      "50 - Arquivo": "Archive"
    },
    "defaultType": "Note",
    "serialization": {
      "format": "yaml-ld",
      "fieldsFromFrontmatter": ["title", "status", "tags"],
      "preserveFolderAs": "folder"
    },
    "surface": {
      "graph": { "labelField": "folder", "degree": "both" }
    }
  }
}
