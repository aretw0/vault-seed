---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { loadVaultCredentialsHeadspace } from '../../lib/vault-credentials.mjs';

const headspace = await loadVaultCredentialsHeadspace();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const policy = headspace.policy ?? {};
const stackState = headspace.available ? 'available' : 'unavailable';
const trustedIssuers = Array.isArray(policy.trustedIssuers) ? policy.trustedIssuers : [];
const capabilities = [
  { id: 'issue', label: 'Emitir', enabled: Boolean(headspace.capabilities?.issue) },
  { id: 'wallet', label: 'Carteira', enabled: Boolean(headspace.capabilities?.wallet) },
  { id: 'present', label: 'Apresentar', enabled: Boolean(headspace.capabilities?.present) },
  { id: 'verify', label: 'Verificar', enabled: Boolean(headspace.capabilities?.verify) },
];
const policyJson = JSON.stringify(policy, null, 2).replace(/</g, '\\u003c');
---

<StarlightPage
  frontmatter={{
    title: 'Headspace',
    description: 'Superfície local para credenciais verificáveis do vault.',
    template: 'doc',
  }}
  headings={[
    { depth: 2, slug: 'headspace-state', text: 'Estado do headspace' },
    { depth: 2, slug: 'headspace-policy', text: 'Política de verificação' },
    { depth: 2, slug: 'headspace-next', text: 'Próxima costura' },
  ]}
>
  <section class="vault-headspace" data-vault-credentials-headspace data-stack-state={stackState}>
    <p class="vault-lead">
      O headspace usa a política do vault e só ativa emissão, carteira, apresentação e verificação quando
      o stack `credentials:v1` está disponível. Sem o stack, a rota permanece estável e explicita o estado.
    </p>

    <section aria-labelledby="headspace-state">
      <div class="vault-section-header">
        <div>
          <span class="vault-card__eyebrow">Credenciais</span>
          <h2 id="headspace-state">Estado do headspace</h2>
        </div>
        <span class="vault-status" data-state={stackState}>
          {headspace.available ? 'stack disponível' : 'stack indisponível'}
        </span>
      </div>

      <div class="vault-metric-grid" aria-label="Capacidades de credenciais">
        {capabilities.map((capability) => (
          <article class="vault-metric" data-vault-credentials-capability={capability.id}>
            <span class="vault-metric__value">{capability.enabled ? 'ativo' : 'off'}</span>
            <span class="vault-metric__label">{capability.label}</span>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="headspace-policy">
      <div class="vault-section-header">
        <div>
          <span class="vault-card__eyebrow">Produto</span>
          <h2 id="headspace-policy">Política de verificação</h2>
        </div>
        <span class="vault-status">{trustedIssuers.length} emissores confiáveis</span>
      </div>

      <div class="vault-insight-grid">
        <article class="vault-card">
          <span class="vault-card__eyebrow">Confiança</span>
          <h3 class="vault-card__title">Autoemissão</h3>
          <p class="vault-card__body">{policy.trustSelf ? 'habilitada' : 'desabilitada'}</p>
        </article>

        <article class="vault-card">
          <span class="vault-card__eyebrow">Revogação</span>
          <h3 class="vault-card__title">Status</h3>
          <p class="vault-card__body">{policy.revocation ?? 'required'}</p>
        </article>

        <article class="vault-card">
          <span class="vault-card__eyebrow">Validade</span>
          <h3 class="vault-card__title">Janela temporal</h3>
          <p class="vault-card__body">{policy.validity ?? 'required'}</p>
        </article>
      </div>

      <pre class="vault-headspace__policy"><code>{policyJson}</code></pre>
    </section>

    <section aria-labelledby="headspace-next" class="vault-graph-preview">
      <div class="vault-section-header">
        <div>
          <span class="vault-card__eyebrow">Próxima fatia</span>
          <h2 id="headspace-next">Carteira e verificador</h2>
        </div>
        <a class="vault-button vault-button--secondary" href={`${base}/records-manifest.json`}>Ver manifesto</a>
      </div>
      <p class="vault-card__body">
        A próxima costura visível é uma carteira local sobre `storage:v1` e um verificador que chama
        `verify(input, policy)` pela seam `.site/lib/vault-credentials.mjs`.
      </p>
    </section>
  </section>
</StarlightPage>
