{
  "name": "digital-gardening-kit",
  "version": "0.4.2",
  "description": "Kit de ferramentas para a jardinagem digital",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aretw0/vault-seed.git"
  },
  "scripts": {
    "test": "vitest run",
    "mdt:check": "mdt check",
    "mdt:update": "mdt update",
    "substrate:check": "node packages/cli/vendor/check-substrate.mjs",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check .",
    "lint:main": "markdownlint --config .markdownlint.json \"10 - Diário/**/*.md\" \"20 - Projetos/**/*.md\" \"30 - Áreas/**/*.md\" \"40 - Recursos/**/*.md\" \"50 - Arquivo/**/*.md\" \"99 - Meta e Anexos/**/*.md\"",
    "lint:docs": "markdownlint --config docs/.markdownlint.json \"docs/**/*.md\"",
    "lint:templates": "markdownlint --config \"90 - Modelos/.markdownlint.json\" \"90 - Modelos/**/*.md\"",
    "lint": "pnpm run lint:main && pnpm run lint:docs && pnpm run lint:templates",
    "smoke:template": "node scripts/smoke_template.js",
    "smoke:init:reset": "node scripts/smoke_initialize_reset.mjs",
    "smoke:user-vault": "node scripts/smoke_user_vault.mjs",
    "smoke:e2e": "node scripts/smoke_user_e2e.mjs",
    "smoke:e2e:full": "node scripts/smoke_user_e2e.mjs --full",
    "validate:onboarding": "node scripts/validate_onboarding.js",
    "validate:pt-text": "node scripts/check_pt_text.js",
    "validate:theme": "node scripts/check_theme.js",
    "validate:mermaid": "node scripts/check_mermaid.js",
    "validate:texto": "uv run python packages/cli/vendor/quality/avaliar_textos.py --only-published",
    "validate:apresentacoes": "uv run python packages/cli/vendor/quality/avaliar_apresentacoes.py",
    "actions:pins": "node scripts/check_github_action_pins.mjs",
    "site:dev": "astro dev",
    "site:dev:lab": "pnpm run notebooks:export:public && astro dev",
    "site:dev:lab:host": "pnpm run notebooks:export:public && astro dev --host 0.0.0.0",
    "site:build": "node scripts/clean_site_dist.mjs && pnpm --filter @aretw0/dgk-astro-plugins build && astro build",
    "site:preview": "astro preview",
    "site:check": "node scripts/smoke_site.js",
    "site:responsive": "pnpm run site:build && pnpm run notebooks:export && node scripts/smoke_responsive.mjs",
    "site:graph-smoke": "pnpm run site:build && node scripts/graph_interactions_smoke.mjs",
    "site:graph-perf-smoke": "pnpm run site:build && node scripts/graph_interactions_perf_smoke.mjs",
    "site:test": "node --test scripts/mermaid_render_contract.test.js scripts/mermaid_toggle.test.js",
    "site:audit:sidebar": "node scripts/audit_sidebar.js",
    "audit:ia": "node scripts/audit_information_architecture.mjs",
    "notebooks:data": "node scripts/generate_vault_data.mjs",
    "records:manifest": "node scripts/generate_records_manifest.mjs",
    "records:profile": "node scripts/vault_records_profile.mjs",
    "notebooks:etl:demo": "node scripts/lab_etl_demo.mjs",
    "feeds:opml": "node scripts/prepare_feed_sources.mjs",
    "outbox:prepare": "node scripts/prepare_publication_outbox.mjs",
    "artifacts:manifest": "node scripts/generate_task_artifacts_manifest.mjs",
    "notebooks:etl": "pnpm run notebooks:etl:demo && pnpm run feeds:opml && pnpm run outbox:prepare && pnpm run validate:texto && node scripts/prepare_lab_datasets.mjs",
    "notebooks:extract:local": "pnpm run notebooks:etl",
    "notebooks:extract:check": "uv run --no-project --with-requirements requirements.local-etl.txt python scripts/check_lab_extract_tools.py",
    "notebooks:extract:browser": "uv run --no-project --with-requirements requirements.local-etl.txt playwright install chromium",
    "notebooks:dev": "node scripts/notebooks_dev.mjs",
    "notebooks:check": "node scripts/notebooks_check.mjs",
    "notebooks:pair": "node scripts/notebooks_pair.mjs",
    "notebooks:export": "node scripts/export_notebooks.mjs",
    "notebooks:export:public": "node scripts/export_notebooks.mjs --public",
    "telegram:outbox": "node scripts/publish_to_telegram.mjs",
    "telegram:inbox": "node scripts/inbox_from_telegram.mjs",
    "diagrams:update": "mdt update",
    "diagrams:check": "mdt check",
    "release:package:smoke": "node scripts/release_package_smoke.mjs",
    "release:package:smoke:json": "node scripts/release_package_smoke.mjs --json",
    "refarm:publication:plan": "node scripts/check_refarm_publication_readiness.mjs --plan-only",
    "test:python": "uv run python packages/cli/vendor/quality/test_avaliar_textos.py",
    "validate": "pnpm run actions:pins && pnpm run lint && pnpm run audit:ia && pnpm run site:audit:sidebar && pnpm run test && pnpm run validate:onboarding && pnpm run validate:pt-text && pnpm run validate:theme && pnpm run validate:mermaid && pnpm run validate:texto && pnpm run validate:apresentacoes && pnpm run site:graph-smoke && pnpm run site:check && pnpm run smoke:template && pnpm run smoke:init:reset && pnpm run smoke:user-vault && pnpm run smoke:e2e && pnpm run release:package:smoke",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release:verify": "node scripts/verify_release_readiness.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "@aretw0/dgk-channels": "workspace:*",
    "@aretw0/dgk-cli": "workspace:*",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/starlight": "^0.39.3",
    "@changesets/cli": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@refarm.dev/ds": "file:vendor/refarm.dev-ds-0.1.0.tgz",
    "astro": "^6.4.8",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "remark-directive": "^4.0.0",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aretw0/dgk-astro-plugins": "workspace:^",
    "@refarm.dev/artifact-contract-v1": "file:vendor/refarm.dev-artifact-contract-v1-0.1.0.tgz",
    "@refarm.dev/channel-policy-v1": "file:vendor/refarm.dev-channel-policy-v1-0.1.0.tgz",
    "@refarm.dev/content-projection": "file:vendor/refarm.dev-content-projection-0.1.0.tgz",
    "@refarm.dev/credentials-contract-v1": "file:vendor/refarm.dev-credentials-contract-v1-0.1.0.tgz",
    "@refarm.dev/ds-astro": "file:vendor/refarm.dev-ds-astro-0.1.0.tgz",
    "@refarm.dev/enrichment-contract-v1": "file:vendor/refarm.dev-enrichment-contract-v1-0.1.0.tgz",
    "@refarm.dev/identity-heartwood": "file:vendor/refarm.dev-identity-heartwood-0.1.0.tgz",
    "@refarm.dev/local-surface": "file:vendor/refarm.dev-local-surface-0.1.0.tgz",
    "@refarm.dev/quality-contract-v1": "file:vendor/refarm.dev-quality-contract-v1-0.1.0.tgz",
    "@refarm.dev/records-contract-v1": "file:vendor/refarm.dev-records-contract-v1-0.1.0.tgz",
    "@refarm.dev/silo": "file:vendor/refarm.dev-silo-0.1.0.tgz",
    "@refarm.dev/source-web": "file:vendor/refarm.dev-source-web-0.1.0.tgz",
    "@refarm.dev/storage-memory": "file:vendor/refarm.dev-storage-memory-0.1.0.tgz"
  }
}
